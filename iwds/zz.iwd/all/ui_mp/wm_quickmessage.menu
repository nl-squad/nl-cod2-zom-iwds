#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

{
	menuDef
	{
		name			"quickmessage"
		visible			0
		fullscreen		0
		rect			0 0 640 480 0 0
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
		style			WINDOW_STYLE_EMPTY

		onOpen
		{
			setDvar cl_bypassMouseInput "1"
		}
		onClose
		{
			setDvar cl_bypassMouseInput "0"
		}

		NL_QCARD(342, 78, "nl_qt_quick")
		NL_QLIST(382, "1\n2\n3\n4", "Voice Messages\nPlayer Options\nHunters\nVIP")

		execKey "v" { close quickmessage; open voice_cmd; }
		execKey "1" { close quickmessage; open voice_cmd; }
		execKey "2" { close quickmessage; open playeroption; }
		execKey "3" { close quickmessage; open hunters; }
		execKey "4"
		{
			close quickmessage;
			uiScript openMenuOnDvar ui_vip 1 vips;
			scriptMenuResponse "VIP";
		}
		execKey "5"
		{
			close quickmessage;
			uiScript openMenuOnDvar ui_vip 1 vips;
			scriptMenuResponse "VIP";
		}
		execKey "x"
		{
			close quickmessage;
			uiScript openMenuOnDvar ui_adm 1 admin_menu;
		}
	}
}
