#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_IMAGE			360 92

#define SROW(_hl, _origin, _requirement, _name, _key, _enter, _action) \
		itemDef \
		{ \
			name			"hl" ## _hl \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 260 18 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE_HOVER \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			name			"hl" ## _hl \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 3 18 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			0 0 260 18 0 0 \
			origin			_origin \
			text			_requirement \
			textfont		NL_FONT \
			textscale		.19 \
			textalign		ITEM_ALIGN_RIGHT \
			textalignx		252 \
			textaligny		13 \
			forecolor		NL_MUTED \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			rect			0 0 260 18 0 0 \
			origin			_origin \
			text			_name \
			textfont		NL_FONT \
			textscale		.22 \
			textalignx		12 \
			textaligny		13 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			action \
			{ \
				_action \
			} \
			mouseEnter \
			{ \
				play "mouse_over"; \
				show "hl" ## _hl; \
				_enter \
			} \
			mouseExit \
			{ \
				hide "hl" ## _hl; \
			} \
		}

{
	menuDef
	{
		name			"weapon_secondary"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc
		{
			close weapon_secondary;
			open weapon_american;
		}
		onOpen
		{
			setdvar nl_weapon "nl_blank";
		}

		NL_BACKDROP
		NL_HEADER("Secondary weapon")

		itemDef
		{
			style			WINDOW_STYLE_DVAR_SHADER
			rect			0 0 160 160 0 0
			origin			ORIGIN_IMAGE
			dvar			nl_weapon
			visible			1
			decoration
		}

		SROW("s1", 40 88, "", "Colt", "none", setdvar nl_weapon "nl_img_zomcolt";, play "mouse_click"; scriptMenuResponse "zomcolt_mp";)
		SROW("s2", 40 106, "^9Rank 12", "Nambu", "none", setdvar nl_weapon "nl_img_nambu";, play "mouse_click"; scriptMenuResponse "nambu_mp";)
		SROW("s3", 40 124, "^9Rank 22", "USP", "none", setdvar nl_weapon "nl_img_usp";, play "mouse_click"; scriptMenuResponse "usp_mp";)
		SROW("s4", 40 142, "^9Rank 42", "Mac10", "none", setdvar nl_weapon "nl_img_mac";, play "mouse_click"; scriptMenuResponse "mac_mp";)
		SROW("s5", 40 160, "^9Rank 62", "Beretta", "none", setdvar nl_weapon "nl_img_beretta";, play "mouse_click"; scriptMenuResponse "beretta_mp";)
		SROW("s6", 40 178, "^9Rank 82", "Glock", "none", setdvar nl_weapon "nl_img_glock";, play "mouse_click"; scriptMenuResponse "glock_mp";)
		SROW("s7", 40 196, "^9Rank 100", "^3Golden ^7Desert Eagle", "none", setdvar nl_weapon "nl_img_deagle";, play "mouse_click"; scriptMenuResponse "deagle_mp";)
		SROW("s9", 40 232, "^3VIP", "Bash King", "none", setdvar nl_weapon "nl_img_bashbat";, play "mouse_click"; scriptMenuResponse "bashbat_mp";)

		NL_INFO(40 404)
		NL_FOOTER
		NL_HINT_ESC(40 432, "Back to loadout", 120, close weapon_secondary; open weapon_american;)
	}
}
