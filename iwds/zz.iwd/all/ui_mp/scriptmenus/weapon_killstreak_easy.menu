		NL_TILE(ORIGIN_T7, "9", "hover_9", "reward_9", "Thunderclaps", "15 kills", "hud_thunder")
		NL_TILE(ORIGIN_T8, "8", "hover_8", "reward_8", "Ammo Pack", "18 kills", "nl_hud_kr4")
		NL_TILE(ORIGIN_T9, "4", "hover_4", "reward_4", "Mortar", "20 kills", "nl_hud_kr13")
		NL_TILE(ORIGIN_T10, "11", "hover_11", "reward_11", "Rambo Mode", "25 kills", "nl_hud_kr15")
		NL_TILE(ORIGIN_T11, "12", "hover_12", "reward_12", "Sentry Gun", "30 kills", "nl_hud_kr14")
		NL_TILE(ORIGIN_T12, "14", "hover_14", "reward_14", "Rocket", "35 kills", "nl_hud_kr17")
		NL_TILE(ORIGIN_T13, "10", "hover_10", "reward_10", "Launcher", "40 kills", "nl_hud_kr11")
		NL_TILE(ORIGIN_T14, "13", "hover_13", "reward_13", "Raptor", "50 kills", "nl_hud_kr21")
		NL_TILE(ORIGIN_T15, "15", "hover_15", "reward_15", "Nuke", "150 kills", "nl_hud_kr18")

