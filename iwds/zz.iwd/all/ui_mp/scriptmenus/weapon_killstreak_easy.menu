		NL_HINT_ESC(40 432, "Back to Loadout", 120, close weapon_killstreak_easy; open weapon_american;)
		NL_HINT_KEY(180 432, "nl_kbd_u", "Unselect All", 90, scriptMenuResponse "reset_ks";)
		execKey "u" { scriptMenuResponse "reset_ks"; play "mouse_click"; }
	}
