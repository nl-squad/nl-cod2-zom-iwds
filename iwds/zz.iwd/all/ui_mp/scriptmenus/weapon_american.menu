#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_PRIMARY			40 84
#define ORIGIN_TACTICAL			320 84
#define ORIGIN_COMBAT			464 84
#define ORIGIN_KILLSTREAKS		40 212
#define ORIGIN_ZOMBIE			320 212
#define ORIGIN_SKIN				464 212
#define ORIGIN_SAVE				40 346
#define ORIGIN_LOAD				40 370
#define ORIGIN_SPAWN			388 348
#define ORIGIN_SPAWN_KEY		480 358

#define CARD(_origin, _w, _label, _action) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 _w 120 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 _w 120 0 0 \
			origin			_origin \
			backcolor		NL_CLEAR \
			border			1 \
			bordercolor		NL_LINE \
			text			_label \
			textfont		NL_FONT \
			textscale		.22 \
			textalignx		10 \
			textaligny		17 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor bordercolor NL_LINE_HOVER; \
			} \
			mouseExit \
			{ \
				setcolor bordercolor NL_LINE; \
			} \
			action \
			{ \
				play "mouse_click"; \
				_action \
			} \
		}

// Small text link in a card's bottom-right corner
#define CARD_RESET(_origin, _x, _text, _response) \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			rect			_x 104 40 14 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.19 \
			textalign		ITEM_ALIGN_RIGHT \
			textalignx		36 \
			textaligny		10 \
			forecolor		NL_MUTED \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		}

#define PICTURE(_origin, _rect, _dvar) \
		itemDef \
		{ \
			style			WINDOW_STYLE_DVAR_SHADER \
			rect			_rect \
			origin			_origin 0 0 \
			dvar			_dvar \
			visible			1 \
			decoration \
		}

#define KS_SLOT(_x, _dvar) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			_x 32 52 52 0 0 \
			origin			ORIGIN_KILLSTREAKS \
			backcolor		0 0 0 0.3 \
			border			1 \
			bordercolor		NL_LINE \
			visible			1 \
			decoration \
		} \
		PICTURE(ORIGIN_KILLSTREAKS, _x 32 52 52 0 0, _dvar)

#define CLASS_LABEL(_origin, _text) \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			0 0 0 0 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.21 \
			textaligny		13 \
			forecolor		NL_MUTED \
			visible			1 \
			decoration \
		}

{
	menuDef
	{
		name			"weapon_american"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onOpen
		{
			setdvar nl_kr_info "";
		}
		onEsc
		{
			close weapon_american;
		}

		NL_BACKDROP
		NL_HEADER("Loadout")

		CARD(ORIGIN_PRIMARY, 272, "Primary Weapon", close weapon_american; open weapon_select;)
		PICTURE(ORIGIN_PRIMARY, 48 24 176 88 0 0, nl_primary)

		CARD(ORIGIN_TACTICAL, 136, "Tactical Perk", close weapon_american; open perks_tactical;)
		PICTURE(ORIGIN_TACTICAL, 36 28 64 64 0 0, nl_tp)

		CARD(ORIGIN_COMBAT, 136, "Combat Perk", close weapon_american; open perks_combat;)
		PICTURE(ORIGIN_COMBAT, 36 28 64 64 0 0, nl_cp)

		CARD(ORIGIN_KILLSTREAKS, 272, "Killstreaks", close weapon_american; scriptMenuResponse "open_killstreak_menu";)
		KS_SLOT(17, nl_kr_1)
		KS_SLOT(79, nl_kr_2)
		KS_SLOT(141, nl_kr_3)
		KS_SLOT(203, nl_kr_4)
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			203 84 52 0 0 0
			origin			ORIGIN_KILLSTREAKS
			text			"VIP"
			textfont		NL_FONT
			textscale		.17
			textalign		ITEM_ALIGN_CENTER
			textalignx		26
			textaligny		12
			forecolor		NL_MUTED
			visible			1
			decoration
		}
		CARD_RESET(ORIGIN_KILLSTREAKS, 228, "Clear", "reset_ks")

		CARD(ORIGIN_ZOMBIE, 136, "Zombie Profile", close weapon_american; open weapon_zombie;)
		PICTURE(ORIGIN_ZOMBIE, 36 26 64 64 0 0, nl_zombiegun)

		CARD(ORIGIN_SKIN, 136, "Skin", close weapon_american; open character_skin;)
		PICTURE(ORIGIN_SKIN, 22 18 92 92 0 0, nl_appereance)

		CLASS_LABEL(ORIGIN_SAVE, "Save")
		NL_BUTTON(80 346, 70, 35, "Class 1", scriptMenuResponse "save_loadout1";)
		NL_BUTTON(156 346, 70, 35, "Class 2", scriptMenuResponse "save_loadout2";)
		NL_BUTTON(232 346, 80, 40, "^3VIP ^7Class 3", scriptMenuResponse "save_loadout3";)

		CLASS_LABEL(ORIGIN_LOAD, "Load")
		NL_BUTTON(80 370, 70, 35, "Class 1", scriptMenuResponse "loadout1";)
		NL_BUTTON(156 370, 70, 35, "Class 2", scriptMenuResponse "loadout2";)
		NL_BUTTON(232 370, 80, 40, "^3VIP ^7Class 3", scriptMenuResponse "loadout3";)

		NL_CTA("spawn_btn", "spawn_btn_hover", ORIGIN_SPAWN, 144, 36, 62, 23, "Spawn", scriptMenuResponse "spawn";)
		NL_KEYCAP(ORIGIN_SPAWN_KEY, "nl_kbd_s", 16)
		execKey "s" { scriptMenuResponse "spawn"; }

		NL_INFO(40 404)
		NL_FOOTER
		NL_HINT_KEY(40 432, "nl_kbd_m", "Main Menu", 90, close weapon_american; open main;)
		execKey "m" { close weapon_american; open main; }
		NL_HINT_KEY(140 432, "nl_kbd_i", "Game Menu", 90, close weapon_american; open ingame;)
		execKey "i" { close weapon_american; open ingame; }
	}
}
