#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_PRIMARY			40 84
#define ORIGIN_TACTICAL			320 84
#define ORIGIN_COMBAT			464 84
#define ORIGIN_KILLSTREAKS		40 212
#define ORIGIN_KILLSTREAK_PICTURES	42 214
#define ORIGIN_ZOMBIE			320 212
#define ORIGIN_SKIN				464 212
#define ORIGIN_SAVE				300 348
#define ORIGIN_SAVE_KEY			392 358
#define ORIGIN_SPAWN			456 348
#define ORIGIN_SPAWN_KEY		548 358

#define CARD(_origin, _w, _innerW, _label, _action) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			2 2 _innerW 118 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 _w 120 0 0 \
			origin			_origin \
			backcolor		NL_CLEAR \
			border			1 \
			bordercolor		NL_LINE \
			text			_label \
			textfont		NL_FONT \
			textscale		.22 \
			textalignx		10 \
			textaligny		17 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor bordercolor NL_LINE_HOVER; \
			} \
			mouseExit \
			{ \
				setcolor bordercolor NL_LINE; \
			} \
			action \
			{ \
				play "mouse_click"; \
				_action \
			} \
		}

// Small text link in a card's bottom-right corner
#define CARD_RESET(_origin, _x, _text, _response) \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			rect			_x 104 40 14 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.19 \
			textalign		ITEM_ALIGN_RIGHT \
			textalignx		36 \
			textaligny		10 \
			forecolor		NL_MUTED \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		}

#define PICTURE(_origin, _rect, _dvar) \
		itemDef \
		{ \
			style			WINDOW_STYLE_DVAR_SHADER \
			rect			_rect \
			origin			_origin 0 0 \
			dvar			_dvar \
			visible			1 \
			decoration \
		}

#define KS_SLOT(_x, _dvar) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			_x 32 50 50 0 0 \
			origin			ORIGIN_KILLSTREAK_PICTURES \
			backcolor		0 0 0 0.3 \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			_x 32 52 52 0 0 \
			origin			ORIGIN_KILLSTREAKS \
			backcolor		NL_CLEAR \
			border			1 \
			bordercolor		NL_LINE \
			visible			1 \
			decoration \
		} \
		PICTURE(ORIGIN_KILLSTREAK_PICTURES, _x 32 50 50 0 0, _dvar)

#define CARD_KEY(_origin, _x, _image) \
		itemDef \
		{ \
			style			WINDOW_STYLE_SHADER \
			rect			_x 6 16 16 0 0 \
			origin			_origin \
			background		_image \
			visible			1 \
			decoration \
		}

#define VIP_COLOR			0.96 0.77 0.26 1
#define SAVED_TEXT			0.55 0.57 0.62 0.6

#define CLASS_TAB_SELECTED(_x, _num, _text, _texty) \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			_x 35 96 35 0 0 \
			text			_text \
			textfont		NL_FONT \
			textscale		.24 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		48 \
			textaligny		_texty \
			forecolor		NL_TEXT \
			dvartest		"nl_loadout" \
			showDvar		{ _num } \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			_x 67 96 3 0 0 \
			backcolor		NL_BLUE \
			dvartest		"nl_loadout" \
			showDvar		{ _num } \
			visible			1 \
			decoration \
		}

#define CLASS_CAPTION(_x, _caption, _color) \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			_x 35 96 35 0 0 \
			text			_caption \
			textfont		NL_FONT \
			textscale		.15 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		48 \
			textaligny		28 \
			forecolor		_color \
			visible			1 \
			decoration \
		}

#define CLASS_TAB(_x, _num, _response, _text, _texty) \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			_x 35 96 35 0 0 \
			backcolor		NL_CLEAR \
			text			_text \
			textfont		NL_FONT \
			textscale		.24 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		48 \
			textaligny		_texty \
			forecolor		NL_MUTED \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor backcolor 1 1 1 0.06; \
			} \
			mouseExit \
			{ \
				setcolor backcolor NL_CLEAR; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		} \
		CLASS_TAB_SELECTED(_x, _num, _text, _texty)

{
	menuDef
	{
		name			"weapon_american"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onOpen
		{
			setdvar nl_kr_info "";
		}
		onEsc
		{
			close weapon_american;
		}

		NL_BACKDROP
		NL_HEADER("Loadout")

		CLASS_TAB(216, "1", "loadout1", "Class 1", 23)
		CLASS_TAB(312, "2", "loadout2", "Class 2", 23)
		CLASS_TAB(408, "3", "loadout3", "Class 3", 18)
		CLASS_CAPTION(408, "VIP ONLY", VIP_COLOR)
		CLASS_TAB(504, "4", "loadout4", "Class 4", 18)
		CLASS_CAPTION(504, "PATRON ONLY", NL_GOLD)
		execKey "1" { scriptMenuResponse "loadout1"; }
		execKey "2" { scriptMenuResponse "loadout2"; }
		execKey "3" { scriptMenuResponse "loadout3"; }
		execKey "4" { scriptMenuResponse "loadout4"; }

		CARD(ORIGIN_PRIMARY, 272, 270, "Primary Weapon", close weapon_american; open weapon_select;)
		PICTURE(ORIGIN_PRIMARY, 48 24 176 88 0 0, nl_primary)
		CARD_KEY(ORIGIN_PRIMARY, 246, "nl_kbd_dim_w")
		execKey "w" { close weapon_american; open weapon_select; }

		CARD(ORIGIN_TACTICAL, 136, 134, "Tactical Perk", close weapon_american; open perks_tactical;)
		PICTURE(ORIGIN_TACTICAL, 36 28 64 64 0 0, nl_tp)
		CARD_KEY(ORIGIN_TACTICAL, 110, "nl_kbd_dim_t")
		execKey "t" { close weapon_american; open perks_tactical; }

		CARD(ORIGIN_COMBAT, 136, 134, "Combat Perk", close weapon_american; open perks_combat;)
		PICTURE(ORIGIN_COMBAT, 36 28 64 64 0 0, nl_cp)
		CARD_KEY(ORIGIN_COMBAT, 110, "nl_kbd_dim_c")
		execKey "c" { close weapon_american; open perks_combat; }

		CARD(ORIGIN_KILLSTREAKS, 272, 270, "Killstreaks", close weapon_american; scriptMenuResponse "open_killstreak_menu";)
		CARD_KEY(ORIGIN_KILLSTREAKS, 246, "nl_kbd_dim_k")
		execKey "k" { close weapon_american; scriptMenuResponse "open_killstreak_menu"; }
		KS_SLOT(17, nl_kr_1)
		KS_SLOT(79, nl_kr_2)
		KS_SLOT(141, nl_kr_3)
		KS_SLOT(203, nl_kr_4)
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			203 84 52 0 0 0
			origin			ORIGIN_KILLSTREAKS
			text			"VIP"
			textfont		NL_FONT
			textscale		.17
			textalign		ITEM_ALIGN_CENTER
			textalignx		26
			textaligny		12
			forecolor		NL_MUTED
			visible			1
			decoration
		}
		CARD_RESET(ORIGIN_KILLSTREAKS, 228, "Clear", "reset_ks")

		CARD(ORIGIN_ZOMBIE, 136, 134, "Zombie Profile", close weapon_american; open weapon_zombie;)
		PICTURE(ORIGIN_ZOMBIE, 36 26 64 64 0 0, nl_zombiegun)
		CARD_KEY(ORIGIN_ZOMBIE, 110, "nl_kbd_dim_z")
		execKey "z" { close weapon_american; open weapon_zombie; }

		CARD(ORIGIN_SKIN, 136, 134, "Skin", close weapon_american; open character_skin;)
		PICTURE(ORIGIN_SKIN, 22 18 92 92 0 0, nl_appereance)
		CARD_KEY(ORIGIN_SKIN, 110, "nl_kbd_dim_a")
		execKey "a" { close weapon_american; open character_skin; }

		itemDef
		{
			name			"save_btn"
			style			WINDOW_STYLE_SHADER
			rect			0 0 144 36 0 0
			origin			ORIGIN_SAVE
			background		"nl_btn_grey"
			dvartest		"nl_loadout_dirty"
			showDvar		{ "1" }
			visible			1
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			0 0 144 36 0 0
			origin			ORIGIN_SAVE
			background		"nl_btn_grey"
			forecolor		1 1 1 0.4
			dvartest		"nl_loadout_dirty"
			hideDvar		{ "1" }
			visible			1
			decoration
		}
		itemDef
		{
			name			"save_btn_hover"
			style			WINDOW_STYLE_SHADER
			rect			0 0 144 36 0 0
			origin			ORIGIN_SAVE
			background		"nl_btn_grey_h"
			dvartest		"nl_loadout_dirty"
			showDvar		{ "1" }
			visible			0
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_BUTTON
			rect			0 0 144 36 0 0
			origin			ORIGIN_SAVE
			text			"Save"
			textfont		NL_FONT_BOLD
			textscale		.28
			textalign		ITEM_ALIGN_CENTER
			textalignx		62
			textaligny		23
			forecolor		NL_TEXT
			dvartest		"nl_loadout_dirty"
			showDvar		{ "1" }
			visible			1
			mouseEnter
			{
				play "mouse_over";
				show save_btn_hover;
				hide save_btn;
			}
			mouseExit
			{
				show save_btn;
				hide save_btn_hover;
			}
			action
			{
				play "mouse_click";
				show save_btn;
				hide save_btn_hover;
				scriptMenuResponse "save_loadout";
			}
		}
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			0 0 16 16 0 0
			origin			ORIGIN_SAVE_KEY
			background		"nl_kbd_v"
			dvartest		"nl_loadout_dirty"
			showDvar		{ "1" }
			visible			1
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			0 0 144 36 0 0
			origin			ORIGIN_SAVE
			text			"Saved"
			textfont		NL_FONT_BOLD
			textscale		.28
			textalign		ITEM_ALIGN_CENTER
			textalignx		72
			textaligny		23
			forecolor		SAVED_TEXT
			dvartest		"nl_loadout_dirty"
			hideDvar		{ "1" }
			visible			1
			decoration
		}
		execKey "v" { scriptMenuResponse "save_loadout"; }

		NL_CTA("spawn_btn", "spawn_btn_hover", ORIGIN_SPAWN, 144, 36, 62, 23, "Spawn", scriptMenuResponse "spawn";)
		NL_KEYCAP(ORIGIN_SPAWN_KEY, "nl_kbd_s", 16)
		execKey "s" { scriptMenuResponse "spawn"; }

		NL_INFO(40 404)
		NL_FOOTER
		NL_HINT_KEY(40 432, "nl_kbd_m", "Main Menu", 90, close weapon_american; open main;)
		execKey "m" { close weapon_american; open main; }
		NL_HINT_KEY(140 432, "nl_kbd_i", "Game Menu", 90, close weapon_american; open ingame;)
		execKey "i" { close weapon_american; open ingame; }
	}
}
