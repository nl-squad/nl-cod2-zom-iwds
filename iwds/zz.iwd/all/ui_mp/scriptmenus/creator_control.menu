#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

// Script-filled player row: _name holds the name on the left, _detail its rank, score and time played on the right,
// and empty rows hide; the row reads as chosen while cc_ps equals _index
#define CC_PLAYER(_y, _index, _name, _detail, _response) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			40 _y 180 18 0 0 \
			backcolor		NL_BLUE_SOFT \
			dvartest		"cc_ps" \
			showDvar		{ _index } \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			46 _y 0 0 0 0 \
			dvar			_name \
			textfont		NL_FONT \
			textscale		.2 \
			textaligny		13 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			216 _y 0 0 0 0 \
			dvar			_detail \
			textfont		NL_FONT \
			textscale		.15 \
			textalign		ITEM_ALIGN_RIGHT \
			textaligny		12 \
			forecolor		NL_MUTED \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			40 _y 180 18 0 0 \
			backcolor		NL_CLEAR \
			dvartest		_name \
			hideDvar		{ "" } \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor backcolor 1 1 1 0.06; \
			} \
			mouseExit \
			{ \
				setcolor backcolor NL_CLEAR; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		}

// Two-way switch; _chosen names this side's highlight, shown on click while the other side's hides.
// The highlight sits inside the border, which the game draws a unit right and down from the rect
#define CC_TOGGLE(_origin, _w, _innerW, _cx, _text, _chosen, _other, _visible, _response) \
		NL_BUTTON(_origin, _w, _innerW, _cx, _text, scriptMenuResponse _response; show _chosen; hide _other;) \
		itemDef \
		{ \
			name			_chosen \
			style			WINDOW_STYLE_FILLED \
			rect			2 2 _innerW 16 0 0 \
			origin			_origin \
			backcolor		NL_BLUE_SOFT \
			visible			_visible \
			decoration \
		}

// Page arrow for the players, hidden while cc_pp is empty (everyone fits on one page)
#define CC_PAGER_ARROW(_x, _image, _response) \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_SHADER \
			rect			_x 368 18 18 0 0 \
			background		_image \
			forecolor		1 1 1 0.8 \
			dvartest		"cc_pp" \
			hideDvar		{ "" } \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor forecolor 1 1 1 1; \
			} \
			mouseExit \
			{ \
				setcolor forecolor 1 1 1 0.8; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		}

// Text tab; _marker names its blue underline
#define CC_TAB(_origin, _text, _marker, _visible, _action) \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 100 22 0 0 \
			origin			_origin \
			backcolor		NL_CLEAR \
			text			_text \
			textfont		NL_FONT \
			textscale		.24 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		50 \
			textaligny		15 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor backcolor 1 1 1 0.06; \
			} \
			mouseExit \
			{ \
				setcolor backcolor NL_CLEAR; \
			} \
			action \
			{ \
				play "mouse_click"; \
				_action \
			} \
		} \
		itemDef \
		{ \
			name			_marker \
			style			WINDOW_STYLE_FILLED \
			rect			0 21 100 2 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			_visible \
			decoration \
		}

// Group heading above a row of tiles, shown with its tab (_name)
#define CC_LABEL(_origin, _name, _visible, _text) \
		itemDef \
		{ \
			name			_name \
			type			ITEM_TYPE_TEXT \
			rect			0 0 0 0 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.18 \
			textaligny		9 \
			forecolor		NL_MUTED \
			visible			_visible \
			decoration \
		}

// Tier badge heading a row of tiles, shown with its tab (_name)
#define CC_BADGE(_origin, _name, _visible, _image) \
		itemDef \
		{ \
			name			_name \
			style			WINDOW_STYLE_SHADER \
			rect			0 0 40 10 0 0 \
			origin			_origin \
			background		_image \
			visible			_visible \
			decoration \
		}

// Tile picking a reward: the tile is its own button; its highlight shows while cc_sel, which the script sets on a pick,
// equals _reward
#define CC_TILE(_origin, _name, _visible, _text, _reward, _pick) \
		itemDef \
		{ \
			name			_name \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 50 48 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE \
			border			1 \
			bordercolor		NL_LINE \
			text			_text \
			textfont		NL_FONT \
			textscale		.15 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		25 \
			textaligny		43 \
			forecolor		NL_TEXT_DIM \
			visible			_visible \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor bordercolor NL_LINE_HOVER; \
			} \
			mouseExit \
			{ \
				setcolor bordercolor NL_LINE; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _pick; \
			} \
		} \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			2 2 48 46 0 0 \
			origin			_origin \
			backcolor		NL_BLUE_SOFT \
			dvartest		"cc_sel" \
			showDvar		{ _reward } \
			visible			1 \
			decoration \
		}

// Blue bar over the picked tile's left border, which the game draws a unit right and down from the rect
#define CC_PICKED_BAR(_origin, _reward) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			1 1 3 48 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			dvartest		"cc_sel" \
			showDvar		{ _reward } \
			visible			1 \
			decoration \
		}

#define CC_WEAPON(_origin, _text, _icon, _reward, _pick) \
		CC_TILE(_origin, "weapons", 1, _text, _reward, _pick) \
		itemDef \
		{ \
			name			"weapons" \
			style			WINDOW_STYLE_SHADER \
			rect			4 6 42 21 0 0 \
			origin			_origin \
			background		_icon \
			visible			1 \
			decoration \
		} \
		CC_PICKED_BAR(_origin, _reward)

#define CC_KILLSTREAK(_origin, _text, _icon, _reward, _pick) \
		CC_TILE(_origin, "killstreaks", 0, _text, _reward, _pick) \
		itemDef \
		{ \
			name			"killstreaks" \
			style			WINDOW_STYLE_SHADER \
			rect			11 3 28 28 0 0 \
			origin			_origin \
			background		_icon \
			visible			0 \
			decoration \
		} \
		CC_PICKED_BAR(_origin, _reward)

{
	menuDef
	{
		name			"creator_control"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onOpen
		{
			show weapons;
			hide killstreaks;
			show tab_weapons;
			hide tab_killstreaks;
			show filter_all;
			hide filter_humans;
		}
		onEsc
		{
			close creator_control;
		}

