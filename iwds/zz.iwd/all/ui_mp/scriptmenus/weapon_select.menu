#define WP(_tab, _hl, _origin, _requirement, _name, _weapon, _ammo) \
		itemDef \
		{ \
			name			"hl" ## _hl \
			group			"hl" \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 260 18 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE_HOVER \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			name			"hl" ## _hl \
			group			"hl" \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 3 18 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			group			"tab_" ## _tab \
			type			ITEM_TYPE_TEXT \
			rect			0 0 260 18 0 0 \
			origin			_origin \
			text			_requirement \
			textfont		NL_FONT \
			textscale		.19 \
			textalign		ITEM_ALIGN_RIGHT \
			textalignx		252 \
			textaligny		13 \
			forecolor		NL_MUTED \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			group			"tab_" ## _tab \
			type			ITEM_TYPE_BUTTON \
			rect			0 0 260 18 0 0 \
			origin			_origin \
			text			_name \
			textfont		NL_FONT \
			textscale		.22 \
			textalignx		12 \
			textaligny		13 \
			forecolor		NL_TEXT_DIM \
			visible			0 \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _weapon ## "_mp"; \
			} \
			mouseEnter \
			{ \
				play "mouse_over"; \
				show "hl" ## _hl; \
				setdvar nl_weapon "nl_img_" ## _weapon; \
			} \
			mouseExit \
			{ \
				hide "hl" ## _hl; \
			} \
			onFocus \
			{ \
				hide ammo_group; \
				show _weapon ## "_ammo"; \
			} \
		} \
		itemDef \
		{ \
			group			"ammo_group" \
			name			_weapon ## "_ammo" \
			origin			ORIGIN_AMMO \
			text			_ammo \
			textfont		NL_FONT \
			textscale		.18 \
			forecolor		NL_TEXT \
		}

{
	menuDef
	{
		name			"weapon_select"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc
		{
			close weapon_select;
			open weapon_american;
		}
		onOpen
		{
			setdvar nl_kr_info "";
			setdvar nl_weapon "nl_blank";
			hide hl;
			show tab_1;
			hide tab_2;
			hide tab_3;
			hide tab_4;
			show tabon_1;
			hide tabon_2;
			hide tabon_3;
			hide tabon_4;
			hide nlt_tooltip;
			scriptMenuResponse "open";
		}

		NL_BACKDROP
		NL_TITLE("Primary Weapon")
		NL_TOKENS

		NL_RULE(100)
		NL_TAB(40 78, 128, 64, "Semi-Auto & Bolts", "tabon_1", setdvar nl_weapon "nl_blank"; hide tab_1; hide tab_2; hide tab_3; hide tab_4; hide ammo_group; hide tabon_1; hide tabon_2; hide tabon_3; hide tabon_4; show tab_1; show tabon_1;)
		NL_TAB(172 78, 128, 64, "Assaults & SMGs", "tabon_2", setdvar nl_weapon "nl_blank"; hide tab_1; hide tab_2; hide tab_3; hide tab_4; hide ammo_group; hide tabon_1; hide tabon_2; hide tabon_3; hide tabon_4; show tab_2; show tabon_2;)
