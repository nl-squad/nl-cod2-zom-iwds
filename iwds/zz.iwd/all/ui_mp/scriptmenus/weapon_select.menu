#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_IMAGE			344 108
#define ORIGIN_AMMO				344 256
#define ORIGIN_CHOICE1 			40 94
#define ORIGIN_CHOICE2 			40 112
#define ORIGIN_CHOICE3 			40 130
#define ORIGIN_CHOICE4 			40 148
#define ORIGIN_CHOICE5 			40 166
#define ORIGIN_CHOICE6 			40 184
#define ORIGIN_CHOICE7 			40 202
#define ORIGIN_CHOICE8 			40 220
