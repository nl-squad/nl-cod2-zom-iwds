#include "ui/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_LOGO				280 28
#define ORIGIN_TITLE			170 112
#define ORIGIN_TAB1				170 160
#define ORIGIN_TAB2				254 160
#define ORIGIN_INPUT1			170 194
#define ORIGIN_INPUT2			170 226
#define ORIGIN_INPUT3			170 258
#define ORIGIN_INPUT4			170 290
#define ORIGIN_INPUT5			170 322
#define ORIGIN_INFORMATION		170 404

#define FIELD_LABEL(_group, _origin, _text) \
		itemDef \
		{ \
			group			_group \
			type			ITEM_TYPE_TEXT \
			rect			0 0 0 0 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.23 \
			textaligny		17 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			decoration \
		}

#define FIELD_STYLE \
			rect			100 4 200 18 0 0 \
			text			" " \
			textstyle		3 \
			textalign		0 \
			textfont		NL_FONT \
			textscale		.24 \
			textalignx		-4 \
			style			WINDOW_STYLE_FILLED \
			backcolor		0 0 0 0.55 \
			forecolor		NL_TEXT \
			border			WINDOW_BORDER_FULL \
			bordercolor		NL_LINE_STRONG \
			visible			1

// Masked password shown over its edit field
#define FIELD_MASK(_group, _origin, _dvar) \
		itemDef \
		{ \
			group			_group \
			type			ITEM_TYPE_TEXT \
			rect			104 0 0 0 0 0 \
			origin			_origin \
			dvar			_dvar \
			textfont		NL_FONT \
			textscale		.24 \
			textaligny		18 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		}

// Clicking a password field clears it before typing
#define FIELD_CLEAR(_group, _origin, _dvar, _focus) \
		itemDef \
		{ \
			group			_group \
			type			ITEM_TYPE_BUTTON \
			rect			100 4 200 18 0 0 \
			origin			_origin \
			style			WINDOW_STYLE_FILLED \
			border			WINDOW_BORDER_FULL \
			bordercolor		NL_CLEAR \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor bordercolor NL_BLUE; \
			} \
			mouseExit \
			{ \
				setcolor bordercolor NL_CLEAR; \
			} \
			action \
			{ \
				setDvar _dvar ""; \
				setFocus _focus; \
			} \
		}

#define WARNING(_group, _origin) \
		itemDef \
		{ \
			group			_group \
			type			ITEM_TYPE_TEXT \
			rect			0 0 0 0 0 0 \
			origin			_origin \
			dvar			"ui_warn" \
			textfont		NL_FONT \
			textscale		.21 \
			textaligny		12 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		}

#define ACCOUNT_TAB(_origin, _text, _group, _action) \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 80 22 0 0 \
			origin			_origin \
			backcolor		NL_CLEAR \
			text			_text \
			textfont		NL_FONT \
			textscale		.24 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		40 \
			textaligny		15 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				setcolor backcolor 1 1 1 0.06; \
			} \
			mouseExit \
			{ \
				setcolor backcolor NL_CLEAR; \
			} \
			action \
			{ \
				play "mouse_click"; \
				_action \
			} \
		} \
		itemDef \
		{ \
			group			_group \
			style			WINDOW_STYLE_FILLED \
			rect			0 21 80 2 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			1 \
			decoration \
		}

#define SUBMIT(_name, _hover, _group, _origin, _text, _response) \
		itemDef \
		{ \
			name			_name \
			group			_group \
			style			WINDOW_STYLE_SHADER \
			rect			100 4 140 30 0 0 \
			origin			_origin \
			background		"nl_btn_blue" \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			name			_hover \
			style			WINDOW_STYLE_SHADER \
			rect			100 4 140 30 0 0 \
			origin			_origin \
			background		"nl_btn_blue_h" \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			group			_group \
			type			ITEM_TYPE_BUTTON \
			rect			100 4 140 30 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT_BOLD \
			textscale		.25 \
			textalign		ITEM_ALIGN_CENTER \
			textalignx		70 \
			textaligny		20 \
			forecolor		NL_TEXT \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				show _hover; \
				hide _name; \
			} \
			mouseExit \
			{ \
				show _name; \
				hide _hover; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptmenuresponse _response; \
			} \
		}

{
	menuDef
	{
		name			"account"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onESC
		{
			scriptMenuResponse "close";
		}
		onOpen
		{
			exec "setu ui_login _";
			exec "setu ui_email _";
			exec "setu ui_pass _";
			exec "setu ui_repass _";
			exec "set g_scriptMainMenu account";
			exec "writeconfig temp.cfg; exec account; vstr nlautologin_launch; exec temp; openscriptmenu account nlautologin_finished; clear;";
			show loginGroup;
			hide registerGroup;
			scriptMenuResponse "open";
		}

		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			backcolor		0.02 0.024 0.04 0.94
			visible			1
			decoration
		}

		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			0 0 80 80 0 0
			origin			ORIGIN_LOGO
			background		"nl_logo_avard"
			visible			1
			decoration
		}

		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			0 4 3 20 0 0
			origin			ORIGIN_TITLE
			backcolor		NL_BLUE
			visible			1
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			12 0 0 0 0 0
			origin			ORIGIN_TITLE
			text			"Your nL account"
			textfont		NL_FONT_BOLD
			textscale		.4
			textaligny		22
			forecolor		NL_TEXT
			visible			1
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_TITLE
			text			"You need an account to play on NoLimits servers."
			textfont		NL_FONT
			textscale		.21
			textaligny		40
			forecolor		NL_MUTED
			visible			1
			decoration
		}

		/// TABS ///
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			170 182 300 1 0 0
			backcolor		NL_LINE
			visible			1
			decoration
		}
		ACCOUNT_TAB(ORIGIN_TAB1, "Log in", loginGroup, hide registerGroup; show loginGroup; setDvar ui_pass ""; setDvar ui_warn "";)
		ACCOUNT_TAB(ORIGIN_TAB2, "Register", registerGroup, hide loginGroup; show registerGroup; setDvar ui_pass ""; setDvar ui_repass ""; setDvar ui_warn "";)

		/// LOGIN ///
		FIELD_LABEL(loginGroup, ORIGIN_INPUT1, "Login")
		itemDef
		{
			group			loginGroup
			type			ITEM_TYPE_EDITFIELD
			origin			ORIGIN_INPUT1
			dvar			"ui_login"
			textaligny		14
			maxChars		30
			maxpaintchars	30
			FIELD_STYLE
			onFocus
			{
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			accept
			{
				play "mouse_click";
				scriptMenuResponse "login";
			}
		}

		FIELD_LABEL(loginGroup, ORIGIN_INPUT2, "Password")
		itemDef
		{
			name			loginPass
			group			loginGroup
			type			ITEM_TYPE_EDITFIELD
			origin			ORIGIN_INPUT2
			dvar			"ui_pass"
			textaligny		9912
			maxChars		30
			maxpaintchars	30
			FIELD_STYLE
			onFocus
			{
				setDvar ui_pass "";
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			accept
			{
				play "mouse_click";
				scriptMenuResponse "login";
			}
		}
		FIELD_MASK(loginGroup, ORIGIN_INPUT2, "ui_display_pass")

		FIELD_LABEL(loginGroup, ORIGIN_INPUT3, "Auto login")
		itemDef
		{
			group			loginGroup
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_FILLED
			rect			100 5 16 16 0 0
			origin			ORIGIN_INPUT3
			backcolor		0 0 0 0.55
			border			1
			bordercolor		NL_LINE_STRONG
			visible			1
			onFocus
			{
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			action
			{
				play "mouse_click";
				scriptMenuResponse "remember";
			}
		}
		itemDef
		{
			group			loginGroup
			style			WINDOW_STYLE_SHADER
			rect			102 7 12 12 0 0
			origin			ORIGIN_INPUT3
			background		"blanco_tick"
			dvartest		"ui_remember"
			showDvar		{ "1" }
			visible			1
			decoration
		}

		SUBMIT("login_btn", "login_btn_hover", loginGroup, ORIGIN_INPUT4, "Log in", "login")
		WARNING(loginGroup, 170 334)
		FIELD_CLEAR(loginGroup, ORIGIN_INPUT2, ui_pass, loginPass)

		/// REGISTER ///
		FIELD_LABEL(registerGroup, ORIGIN_INPUT1, "Login")
		itemDef
		{
			group			registerGroup
			type			ITEM_TYPE_EDITFIELD
			origin			ORIGIN_INPUT1
			dvar			"ui_login"
			textaligny		14
			maxChars		30
			maxpaintchars	30
			FIELD_STYLE
			onFocus
			{
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			accept
			{
				play "mouse_click";
				scriptMenuResponse "register";
			}
		}

		FIELD_LABEL(registerGroup, ORIGIN_INPUT2, "Email")
		itemDef
		{
			group			registerGroup
			type			ITEM_TYPE_EDITFIELD
			origin			ORIGIN_INPUT2
			dvar			"ui_email"
			textaligny		14
			maxChars		50
			maxpaintchars	30
			FIELD_STYLE
			onFocus
			{
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			accept
			{
				play "mouse_click";
				scriptMenuResponse "register";
			}
		}
		itemDef
		{
			group			registerGroup
			type			ITEM_TYPE_TEXT
			rect			100 29 0 0 0 0
			origin			ORIGIN_INPUT2
			text			"Example: john.doe@example.com"
			textfont		NL_FONT
			textscale		.17
			forecolor		NL_MUTED
			dvartest		"ui_email"
			showDvar		{ "" }
			visible			1
			decoration
		}
		itemDef
		{
			group			registerGroup
			type			ITEM_TYPE_TEXT
			rect			100 29 0 0 0 0
			origin			ORIGIN_INPUT2
			text			"Never shown to others. Used to reset your password."
			textfont		NL_FONT
			textscale		.17
			forecolor		NL_MUTED
			dvartest		"ui_email"
			hideDvar		{ "" }
			visible			1
			decoration
		}

		FIELD_LABEL(registerGroup, ORIGIN_INPUT3, "Password")
		itemDef
		{
			name			registerPass
			group			registerGroup
			type			ITEM_TYPE_EDITFIELD
			origin			ORIGIN_INPUT3
			dvar			"ui_pass"
			textaligny		9912
			maxChars		30
			maxpaintchars	30
			FIELD_STYLE
			onFocus
			{
				setDvar ui_pass "";
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
				setFocus registerPass;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			accept
			{
				play "mouse_click";
				scriptMenuResponse "register";
			}
		}
		FIELD_MASK(registerGroup, ORIGIN_INPUT3, "ui_display_pass")

		FIELD_LABEL(registerGroup, ORIGIN_INPUT4, "Repeat password")
		itemDef
		{
			name			registerRepass
			group			registerGroup
			type			ITEM_TYPE_EDITFIELD
			origin			ORIGIN_INPUT4
			dvar			"ui_repass"
			textaligny		9912
			maxChars		30
			maxpaintchars	30
			FIELD_STYLE
			onFocus
			{
				setDvar ui_repass "";
				play "mouse_over";
				setcolor bordercolor NL_BLUE;
				setFocus registerRepass;
			}
			leaveFocus
			{
				setcolor bordercolor NL_LINE_STRONG;
			}
			accept
			{
				play "mouse_click";
				scriptMenuResponse "register";
			}
		}
		FIELD_MASK(registerGroup, ORIGIN_INPUT4, "ui_display_repass")

		SUBMIT("register_btn", "register_btn_hover", registerGroup, ORIGIN_INPUT5, "Create account", "register")
		WARNING(registerGroup, 170 362)
		FIELD_CLEAR(registerGroup, ORIGIN_INPUT3, ui_pass, registerPass)
		FIELD_CLEAR(registerGroup, ORIGIN_INPUT4, ui_repass, registerRepass)

		/// HELP ///
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			170 386 300 1 0 0
			backcolor		NL_LINE
			visible			1
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_INFORMATION
			text			"^9Website ^8mynl.pl\n^9Discord ^8ds.mynl.pl ^9or ^8discord.gg/37UBvysKQ5\n^9Forgot your password? Message ^8Dusza ^9on Discord."
			textfont		NL_FONT
			textscale		.2
			forecolor		NL_MUTED
			visible			1
			decoration
		}

		NL_BUTTON(40 440, 84, 42, "Disconnect", scriptMenuResponse "leave";)
	}
}
