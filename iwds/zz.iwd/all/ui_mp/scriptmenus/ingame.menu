#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_CHOICE1			40 86
#define ORIGIN_CHOICE2			40 108
#define ORIGIN_CHOICE3			40 130
#define ORIGIN_CHOICE5			40 164
#define ORIGIN_CHOICE6			40 186
#define ORIGIN_CHOICE7			40 208
#define ORIGIN_CHOICE9			40 242
#define ORIGIN_CHOICE10			40 264
#define ORIGIN_PANEL			264 84
#define ORIGIN_RECORDS			264 132
#define ORIGIN_PLROPT2			264 292
#define ORIGIN_PLROPT1			264 330

#define INGAME_SELECTION(_text, _origin, _response, _num) \
		itemDef \
		{ \
			name			"blanco_highlight_menu" ## _num \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 196 20 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE_HOVER \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			name			"blanco_highlight_menu" ## _num \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 3 20 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			rect			0 0 196 20 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.27 \
			textalignx		12 \
			textaligny		15 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				show "blanco_highlight_menu" ## _num; \
			} \
			mouseExit \
			{ \
				hide "blanco_highlight_menu" ## _num; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		}

#define INGAME_SELECTION_OPENSUBMENU(_text, _origin, _submenu, _num) \
		itemDef \
		{ \
			name			"blanco_highlight_menu" ## _num \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 196 20 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE_HOVER \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			name			"blanco_highlight_menu" ## _num \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 3 20 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			rect			0 0 196 20 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.27 \
			textalignx		12 \
			textaligny		15 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				show "blanco_highlight_menu" ## _num; \
			} \
			mouseExit \
			{ \
				hide "blanco_highlight_menu" ## _num; \
			} \
			action \
			{ \
				play "mouse_click"; \
				close ingame; \
				open _submenu; \
			} \
		}

#define INGAME_SELECTION_HOVERSUBMENU(_text, _origin, _submenu, _num, _response) \
		itemDef \
		{ \
			name			"blanco_highlight_menu" ## _num \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 196 20 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE_HOVER \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			name			"blanco_highlight_menu" ## _num \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 3 20 0 0 \
			origin			_origin \
			backcolor		NL_BLUE \
			visible			0 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_BUTTON \
			rect			0 0 196 20 0 0 \
			origin			_origin \
			text			_text \
			textfont		NL_FONT \
			textscale		.27 \
			textalignx		12 \
			textaligny		15 \
			forecolor		NL_TEXT_DIM \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
				show "blanco_highlight_menu" ## _num; \
				hide map; \
				hide map_records; \
				hide blanco_playeroption; \
				show _submenu; \
				scriptMenuResponse _response; \
			} \
			mouseExit \
			{ \
				hide "blanco_highlight_menu" ## _num; \
				show map; \
				show map_records; \
				show blanco_playeroption; \
				hide _submenu; \
			} \
		}

#define RECORD_STRIPE(_y) \
		itemDef \
		{ \
			name			"map_records" \
			style			WINDOW_STYLE_FILLED \
			rect			0 _y 336 12 0 0 \
			origin			ORIGIN_RECORDS \
			backcolor		1 1 1 0.035 \
			visible			1 \
			decoration \
		}

#define RECORD_COLUMN(_x, _title, _dvar) \
		itemDef \
		{ \
			name			"map_records" \
			type			ITEM_TYPE_TEXT \
			rect			_x 0 0 0 0 0 \
			origin			ORIGIN_RECORDS \
			text			_title \
			textfont		NL_FONT \
			textscale		.19 \
			textaligny		10 \
			forecolor		NL_MUTED \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			name			"map_records" \
			type			ITEM_TYPE_TEXT \
			rect			_x 18 0 0 0 0 \
			origin			ORIGIN_RECORDS \
			dvar			_dvar \
			textfont		NL_FONT \
			textscale		.25 \
			textaligny		10 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		}

#define PLAYER_OPTION(_origin, _dvar, _title, _desc, _response) \
		itemDef \
		{ \
			name			blanco_playeroption \
			style			WINDOW_STYLE_DVAR_SHADER \
			rect			0 0 28 28 0 0 \
			origin			_origin \
			dvar			_dvar \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			name			blanco_playeroption \
			type			ITEM_TYPE_TEXT \
			rect			36 0 0 0 0 0 \
			origin			_origin \
			text			_title \
			textfont		NL_FONT \
			textscale		.24 \
			textaligny		13 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			name			blanco_playeroption \
			type			ITEM_TYPE_TEXT \
			rect			36 0 0 0 0 0 \
			origin			_origin \
			text			_desc \
			textfont		NL_FONT \
			textscale		.19 \
			textaligny		25 \
			forecolor		NL_MUTED \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			name			blanco_playeroption \
			type			ITEM_TYPE_BUTTON \
			rect			0 0 240 28 0 0 \
			origin			_origin \
			visible			1 \
			mouseEnter \
			{ \
				play "mouse_over"; \
			} \
			action \
			{ \
				play "mouse_click"; \
				scriptMenuResponse _response; \
			} \
		}

{
	menuDef
	{
		name			"ingame"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onOpen
		{
			hide serverinfo;
			show blanco_playeroption;
			show map;
			show map_records;

			hide blanco_highlight_menu1;
			hide blanco_highlight_menu2;
			hide blanco_highlight_menu3;
			hide blanco_highlight_menu4;
			hide blanco_highlight_menu5;
			hide blanco_highlight_menu6;
			hide blanco_highlight_menu7;
			hide blanco_highlight_menu8;
			hide blanco_highlight_menu9;
			scriptMenuResponse "open";
		}
		onEsc
		{
			close ingame;
		}

		NL_BACKDROP
		NL_HEADER("^7nL^4.^7Zombies")
		NL_NOTE("Version 6.0")

		execKey "1" { play "mouse_click"; scriptMenuResponse "autoassign"; }
		execKey "2" { play "mouse_click"; scriptMenuResponse "changeweapon"; }

		itemDef
		{
			type			ITEM_TYPE_BUTTON
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			visible			1
			action
			{
				scriptMenuResponse "clear";
			}
		}

		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			40 404 0 0 0 0
			dvar			nl_ingame_page
			textfont		NL_FONT
			textscale		.24
			forecolor		NL_TEXT
			visible			1
			decoration
		}

		/// MAP RECORDS ///
		itemDef
		{
			name			"map"
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_PANEL
			dvar			nl_ingame_mapname
			textfont		NL_FONT_BOLD
			textscale		.32
			textaligny		16
			forecolor		NL_TEXT
			visible			1
			decoration
		}
		itemDef
		{
			name			"map_records"
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_PANEL
			text			"Best Scores on This Map"
			textfont		NL_FONT
			textscale		.2
			textaligny		32
			forecolor		NL_MUTED
			visible			1
			decoration
		}
		RECORD_STRIPE(18)
		RECORD_STRIPE(42)
		RECORD_STRIPE(66)
		RECORD_STRIPE(90)
		RECORD_STRIPE(114)
		itemDef
		{
			name			"map_records"
			style			WINDOW_STYLE_FILLED
			rect			0 14 336 1 0 0
			origin			ORIGIN_RECORDS
			backcolor		NL_LINE
			visible			1
			decoration
		}
		RECORD_COLUMN(8, "Player", "nl_records_ever_names")
		RECORD_COLUMN(200, "Score", "nl_records_ever_scores")
		RECORD_COLUMN(280, "Rank", "nl_records_ever_ranks")

		/// PLAYER OPTIONS ///
		PLAYER_OPTION(ORIGIN_PLROPT2, nl_plropt_enableExchange, "Weapon Exchange", "Players can ask you for a weapon exchange", "plropt_enableExchange")
		PLAYER_OPTION(ORIGIN_PLROPT1, nl_plropt_enableHook, "Hook", "Players can ask you for a hook", "plropt_enableHook")

		/// SERVER INFO ///
		itemDef
		{
			name			"serverinfo"
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_PANEL
			text			"Server Info"
			textfont		NL_FONT_BOLD
			textscale		.32
			textaligny		16
			forecolor		NL_TEXT
			visible			1
			decoration
		}
		itemDef
		{
			name			"serverinfo"
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_PANEL
			dvar			nl_serverinfo
			textfont		NL_FONT
			textscale		.22
			textaligny		40
			forecolor		NL_TEXT
			visible			1
			decoration
		}

		INGAME_SELECTION("Loadout", ORIGIN_CHOICE1, "changeweapon", "1")
		INGAME_SELECTION("Shop", ORIGIN_CHOICE2, "purchases", "2")
		INGAME_SELECTION("Challenges", ORIGIN_CHOICE3, "challenges", "3")

		itemDef
		{
			visible			1
			dvartest		"nl_challeges_badge"
			showDvar		{ "1" }
			style			WINDOW_STYLE_SHADER
			rect			76 7 7 7 0 0
			origin			ORIGIN_CHOICE3
			background		"nl_badge_notification"
			decoration
		}
		itemDef
		{
			visible			1
			dvartest		"nl_challeges_badge"
			showDvar		{ "2" }
			style			WINDOW_STYLE_SHADER
			rect			76 7 7 7 0 0
			origin			ORIGIN_CHOICE3
			background		"nl_badge_new"
			decoration
		}

		INGAME_SELECTION("Statistics", ORIGIN_CHOICE5, "stats", "4")
		INGAME_SELECTION("Top Players", ORIGIN_CHOICE6, "topstats", "5")
		INGAME_SELECTION_HOVERSUBMENU("Server Info", ORIGIN_CHOICE7, "serverinfo", "6", "serverinfo")

		INGAME_SELECTION_OPENSUBMENU("Leave Game", ORIGIN_CHOICE9, "leavegame", "7")
		INGAME_SELECTION_OPENSUBMENU("Main Menu", ORIGIN_CHOICE10, "main", "8")

		NL_FOOTER
		NL_HINT_KEY(40 432, "nl_kbd_1", "Play", 60, scriptMenuResponse "autoassign";)
		NL_HINT_KEY(110 432, "nl_kbd_2", "Loadout", 80, scriptMenuResponse "changeweapon";)
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			600 436 0 0 0 0
			text			"^9Updates on Discord ^7#news\n^9Become a ^8Patron^9: Discord ^7#how-to-patron"
			textfont		NL_FONT
			textscale		.19
			textalign		ITEM_ALIGN_RIGHT
			forecolor		NL_MUTED
			visible			1
			decoration
		}
	}

	menuDef
	{
		name			"leavegame"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onOpen
		{
			hide blanco_highlight_menu2;
			hide blanco_highlight_menu3;
		}
		onEsc
		{
			close leavegame;
		}

		execKey "1" { play "mouse_click"; close leavegame; scriptMenuResponse "leave"; }
		execKey "2" { play "mouse_click"; close leavegame; }

		NL_BACKDROP
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			200 176 240 112 0 0
			backcolor		NL_SURFACE_SOLID
			border			1
			bordercolor		NL_LINE
			visible			1
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			201 177 3 110 0 0
			backcolor		NL_BLUE
			visible			1
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			216 176 0 0 0 0
			text			"Leave the game?"
			textfont		NL_FONT_BOLD
			textscale		.32
			textaligny		28
			forecolor		NL_TEXT
			visible			1
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			216 176 0 0 0 0
			text			"You will disconnect from the server."
			textfont		NL_FONT
			textscale		.21
			textaligny		46
			forecolor		NL_MUTED
			visible			1
			decoration
		}
		NL_HINT_KEY(216 248, "nl_kbd_1", "Leave", 80, close leavegame; scriptMenuResponse "leave";)
		NL_HINT_KEY(316 248, "nl_kbd_2", "Stay", 80, close leavegame;)
	}
}
