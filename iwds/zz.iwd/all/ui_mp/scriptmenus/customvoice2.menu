#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

{
	menuDef
	{
		name			"customvoice2"
		fullscreen		0
		rect			0 0 640 480 0 0
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
		style			WINDOW_STYLE_EMPTY

		onOpen
		{
			setDvar cl_bypassMouseInput "1"
		}
		onClose
		{
			setDvar cl_bypassMouseInput "0"
		}

		NL_QCARD(294, 126, "nl_qt_voice_patron")
		NL_QLIST(334, "1\n2\n3\n4\n5\n6\n7\n8\n9", "Another one.\nBozzy czy Ty to widzisz?\nDobre, pomaranczowe.\nDamn.\nJestem hardkorem!\nOMG!\nTo jest zajebiste!\nArrrgh, this sucks.\nNossa nossa!")

		execKey "1" { scriptMenuResponse "1"; close customvoice2 }
		execKey "2" { scriptMenuResponse "2"; close customvoice2 }
		execKey "3" { scriptMenuResponse "3"; close customvoice2 }
		execKey "4" { scriptMenuResponse "4"; close customvoice2 }
		execKey "5" { scriptMenuResponse "5"; close customvoice2 }
		execKey "6" { scriptMenuResponse "6"; close customvoice2 }
		execKey "7" { scriptMenuResponse "7"; close customvoice2 }
		execKey "8" { scriptMenuResponse "8"; close customvoice2 }
		execKey "9" { scriptMenuResponse "9"; close customvoice2 }
	}
}
