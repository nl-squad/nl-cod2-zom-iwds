#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

{
	menuDef
	{
		name			"vips"
		fullscreen		0
		rect			0 0 640 480 0 0
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
		style			WINDOW_STYLE_EMPTY

		onOpen
		{
			setDvar cl_bypassMouseInput "1"
		}
		onClose
		{
			setDvar cl_bypassMouseInput "0"
		}

		NL_QCARD(285, 135, "nl_qt_vip")
		NL_QDVAR(325, nl_vips_dvar)

		execKey "0" { scriptMenuResponse "0"; close vips; }
		execKey "1" { scriptMenuResponse "1"; close vips; }
		execKey "2" { scriptMenuResponse "2"; close vips; }
		execKey "3" { scriptMenuResponse "3"; close vips; }
		execKey "4" { scriptMenuResponse "4"; close vips; }
		execKey "5" { scriptMenuResponse "5"; close vips; }
		execKey "6" { scriptMenuResponse "6"; close vips; }
		execKey "7" { scriptMenuResponse "7"; close vips; }
		execKey "8" { scriptMenuResponse "8"; close vips; }
		execKey "9" { scriptMenuResponse "9"; close vips; }
	}
}
