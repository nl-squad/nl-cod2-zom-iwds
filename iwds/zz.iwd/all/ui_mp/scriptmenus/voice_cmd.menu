#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

{
	menuDef
	{
		name			"voice_cmd"
		visible			0
		fullscreen		0
		rect			0 0 640 480 0 0
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
		style			WINDOW_STYLE_EMPTY

		onOpen
		{
			setDvar cl_bypassMouseInput "1"
		}
		onClose
		{
			setDvar cl_bypassMouseInput "0"
		}

		NL_QCARD(353, 87, "nl_qt_voice")
		NL_QLIST(393, "1\n2\n3\n4\n5", "Commands\nStatements\nResponses\nCustom voice ^3VIP\nCustom voice ^8Patron")

		execKey "1" { close voice_cmd; open quickcommands }
		execKey "2" { close voice_cmd; open quickstatements }
		execKey "3" { close voice_cmd; open quickresponses }
		execKey "4" { close voice_cmd; open customvoice1 }
		execKey "5" { close voice_cmd; open customvoice2 }
	}
}
