#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_MINE				40 84
#define ORIGIN_OTHER			328 84

#define STATS_PANEL(_origin, _title, _dvar) \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			0 0 272 236 0 0 \
			origin			_origin \
			backcolor		NL_SURFACE \
			border			1 \
			bordercolor		NL_LINE \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			0 0 0 0 0 0 \
			origin			_origin \
			text			_title \
			textfont		NL_FONT_BOLD \
			textscale		.26 \
			textalignx		12 \
			textaligny		20 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			style			WINDOW_STYLE_FILLED \
			rect			0 28 272 1 0 0 \
			origin			_origin \
			backcolor		NL_LINE \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			0 0 0 0 0 0 \
			origin			_origin \
			dvar			_dvar \
			textfont		NL_FONT \
			textscale		.25 \
			textaligny		48 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		}

{
	menuDef
	{
		name			"stats"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc
		{
			close stats;
			open ingame;
		}

		NL_BACKDROP
		NL_HEADER("Statistics")

		STATS_PANEL(ORIGIN_MINE, "You", "ui_stats1")
		STATS_PANEL(ORIGIN_OTHER, "Other players", "ui_stats2")

		NL_BUTTON(328 330, 84, 42, "Previous player", scriptMenuResponse "left";)
		NL_BUTTON(516 330, 84, 42, "Next player", scriptMenuResponse "right";)

		NL_INFO(40 400)
		NL_FOOTER
		NL_HINT_ESC(40 432, "Back to game menu", 130, close stats; open ingame;)
	}
}
