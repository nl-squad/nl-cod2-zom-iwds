#include "ui_mp/menudef.h"
#include "ui_mp/nl_style.h"

#define ORIGIN_INTRO			40 90
#define ORIGIN_TABLE			40 138
#define ORIGIN_COLLECT			440 378

#define COLUMN(_x, _title, _dvar) \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			_x 0 0 0 0 0 \
			origin			ORIGIN_TABLE \
			text			_title \
			textfont		NL_FONT \
			textscale		.19 \
			forecolor		NL_MUTED \
			visible			1 \
			decoration \
		} \
		itemDef \
		{ \
			type			ITEM_TYPE_TEXT \
			rect			_x 22 0 0 0 0 \
			origin			ORIGIN_TABLE \
			dvar			_dvar \
			textfont		NL_FONT \
			textscale		.2 \
			forecolor		NL_TEXT \
			visible			1 \
			decoration \
		}

{
	menuDef
	{
		name			"challenges"
		rect			0 0 640 480 0 0
		focuscolor		NL_FOCUS
		style			WINDOW_STYLE_EMPTY
		blurWorld		5.0
		onEsc
		{
			close challenges;
			open ingame;
		}
		onOpen
		{
			scriptMenuResponse "open";
		}

		NL_BACKDROP
		NL_HEADER("Challenges")

		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			0 0 0 0 0 0
			origin			ORIGIN_INTRO
			dvar			"nl_challenges_info"
			textfont		NL_FONT
			textscale		.22
			forecolor		NL_TEXT_DIM
			visible			1
			decoration
		}

		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			0 6 560 1 0 0
			origin			ORIGIN_TABLE
			backcolor		NL_LINE
			visible			1
			decoration
		}
		COLUMN(0, "Challenge", "nl_challenges_desc")
		COLUMN(340, "Progress", "nl_challenges_progress")
		COLUMN(430, "Reward", "nl_challenges_reward")

		NL_CTA("collect_btn", "collect_btn_hover", ORIGIN_COLLECT, 160, 34, 80, 22, "Collect Rewards", scriptMenuResponse "collect";)

		NL_INFO(40 400)
		NL_FOOTER
		NL_HINT_ESC(40 432, "Back to Game Menu", 130, close challenges; open ingame;)
	}
}
